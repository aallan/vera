{
	"name": "vera-language",
	"displayName": "Vera Language",
	"description": "Proof-aware Vera language support: diagnostics, hover, slot navigation, typed-hole completion, and syntax highlighting.",
	"version": "0.2.0",
	"publisher": "veralang",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/aallan/vera"
	},
	"homepage": "https://veralang.dev/",
	"bugs": {
		"url": "https://github.com/aallan/vera/issues"
	},
	"engines": {
		"vscode": "^1.82.0"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"vera",
		"veralang",
		"functional",
		"algebraic effects",
		"contracts",
		"llm",
		"wasm"
	],
	"icon": "images/vera-icon.png",
	"contributes": {
		"languages": [
			{
				"id": "vera",
				"aliases": [
					"Vera",
					"vera"
				],
				"extensions": [
					".vera"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "vera",
				"scopeName": "source.vera",
				"path": "./syntaxes/vera.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "Vera",
			"properties": {
				"vera.lsp.enabled": {
					"type": "boolean",
					"default": true,
					"description": "Start the Vera language server (vera lsp) for .vera files."
				},
				"vera.lsp.path": {
					"type": "string",
					"default": "vera",
					"description": "Command used to launch the language server. Resolution order: this setting (if changed from the default), then a workspace-local venv (.venv/bin/vera, or .venv\\Scripts\\vera.exe on Windows), then \"vera\" from PATH. Install the server from PyPI with: python -m pip install \"veralang[lsp]\"."
				}
			}
		},
		"commands": [
			{
				"command": "vera.lsp.restart",
				"title": "Vera: Restart Language Server"
			}
		]
	},
	"main": "./dist/extension.js",
	"activationEvents": [
		"onLanguage:vera"
	],
	"scripts": {
		"build": "node esbuild.js",
		"check": "node --check extension.js && node --check esbuild.js",
		"package": "vsce package",
		"package:list": "npm run build && vsce ls --tree",
		"vscode:prepublish": "npm run build"
	},
	"dependencies": {
		"vscode-languageclient": "^10.1.0"
	},
	"devDependencies": {
		"@vscode/vsce": "3.9.2",
		"esbuild": "0.28.1"
	}
}
