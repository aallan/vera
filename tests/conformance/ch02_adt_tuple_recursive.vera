-- Conformance: self-recursive ADT with a Tuple-mediated back-reference
-- (Chapter 2). Tests: a `data` type whose recursive occurrence of itself
-- sits inside a `Tuple<Chain, Int>` field, Tuple construction/destructure
-- nested inside a match arm, and Z3 sort construction for a Tuple-carrying
-- recursive group (#881 — such a type once crashed `vera verify` with a
-- raw RecursionError).
private data Chain {
  Tip,
  Link(Tuple<Chain, Int>)
}

private fn length(@Chain -> @Nat)
  requires(true)
  ensures(match @Chain.0 { Tip -> @Nat.result == 0, Link(@Tuple<Chain, Int>) -> @Nat.result >= 1 })
  decreases(@Chain.0)
  effects(pure)
{
  match @Chain.0 {
    Tip -> 0,
    Link(@Tuple<Chain, Int>) -> match @Tuple<Chain, Int>.0 {
      Tuple(@Chain, @Int) -> 1 + length(@Chain.0)
    }
  }
}

-- A recursion's value is no contract's to state (E138: a contract may not
-- call its own function), so the length is checked at run time.
public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result >= 1)
  effects(pure)
{
  let @Nat = length(Link(Tuple(Link(Tuple(Link(Tuple(Tip, 1)), 2)), 3)));
  assert(@Nat.0 == 3);
  nat_to_int(@Nat.0)
}
