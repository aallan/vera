module vera.shadowlib;

-- A module-local data type whose name is one the prelude provides.
-- Spec 8.4.1: the prelude's data types are reserved names in every file
-- (#1469), so this declaration is refused at check (E158) in every program
-- that imports the module.
private data Json {
  JBlob(Int)
}

public fn blob_size(@Int -> @Int)
  requires(true)
  ensures(@Int.result == @Int.0)
  effects(pure)
{
  match JBlob(@Int.0) {
    JBlob(@Int) -> @Int.0
  }
}
