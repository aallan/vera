-- Conformance: built-in types (Chapter 2)
-- Tests: Int, Nat, Bool, String, Float64, Byte, Unit
public fn test_int(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 42)
  effects(pure)
{
  42
}

public fn test_nat(@Unit -> @Nat)
  requires(true)
  ensures(@Nat.result == 10)
  effects(pure)
{
  10
}

public fn test_bool(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  true
}

public fn test_string(@Unit -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  "hello"
}

public fn test_float(@Unit -> @Float64)
  requires(true)
  ensures(true)
  effects(pure)
{
  3.14
}

public fn test_byte(@Byte -> @Byte)
  requires(true)
  ensures(true)
  effects(pure)
{
  @Byte.0
}

-- The run: a value of each built-in type, each on a line of its own (the
-- `Byte` through `byte_to_int`, as its number).
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("int \(test_int(()))\n");
  IO.print("nat \(test_nat(()))\n");
  IO.print("bool \(test_bool(()))\n");
  IO.print("string \(test_string(()))\n");
  IO.print("float \(test_float(()))\n");
  IO.print("byte \(byte_to_int(test_byte(7)))\n")
}
