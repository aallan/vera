-- Conformance: a module data type named after a prelude one is refused at
-- check (Chapter 8, Section 8.4.1).
-- Tests: E158 -- `vera.shadowlib` declares `private data Json { JBlob(Int) }`
-- and this program uses the prelude's `Json`.  The two declarations used to
-- contend for one layout slot and the compile was refused (E621, #1277); the
-- prelude's data types are now reserved names in every file (#1469), so the
-- module's declaration is refused at check.  The paired program,
-- `ch08_module_prelude_adt_name.vera`, imports the same module, never names
-- `Json`, and is refused by the same declaration.
import vera.shadowlib(blob_size);

public fn depth(@Json -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  json_array_length(@Json.0)
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  blob_size(7)
}
