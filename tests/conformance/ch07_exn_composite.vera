-- Conformance: Exn<E> effect handler over a COMPOSITE payload type (Chapter 7)
-- Tests: handle[Exn<Option<Int>>] — the composite E is escaped for the WASM
-- exception tag and the caught-payload @Option<Int> binding materializes under
-- the full canonical slot name so @Option<Int>.0 resolves in the handler (#914).
public fn caught_composite(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 9)
  effects(pure)
{
  handle[Exn<Option<Int>>] {
    throw(@Option<Int>) -> { option_unwrap_or(@Option<Int>.0, 0) }
  } in {
    throw(Some(9))
  }
}

public fn not_thrown(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[Exn<Tuple<Int, Int>>] {
    throw(@Tuple<Int, Int>) -> { 0 }
  } in {
    7
  }
}

-- The run: a composite payload thrown and caught, and a handler whose body
-- throws nothing.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("caught \(caught_composite(()))\n");
  IO.print("not thrown \(not_thrown(()))\n")
}
