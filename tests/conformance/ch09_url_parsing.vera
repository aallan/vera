-- Conformance: url_parse, url_join (Chapter 9)
-- Tests: url_parse returning Result<UrlParts, String>, url_join (types from prelude)
-- Every part, scheme first, each in brackets so an empty part shows.
private fn parts(@UrlParts -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  match @UrlParts.0 {
    UrlParts(@String, @String, @String, @String, @String) -> "[\(@String.4)] [\(@String.3)] [\(@String.2)] [\(@String.1)] [\(@String.0)]"
  }
}

public fn test_parse_full(@Unit -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  match url_parse("https://example.com/path?q=1#frag") {
    Ok(@UrlParts) -> parts(@UrlParts.0),
    Err(@String) -> @String.0
  }
}

public fn test_parse_no_query(@Unit -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  match url_parse("https://example.com/path") {
    Ok(@UrlParts) -> parts(@UrlParts.0),
    Err(@String) -> @String.0
  }
}

public fn test_parse_err(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  match url_parse("no-scheme") {
    Ok(_) -> 0,
    Err(_) -> 1
  }
}

-- RFC 3986 §3.1: scheme must be non-empty.  url_parse(":foo")
-- previously returned Ok with empty scheme then url_join emitted
-- bare "foo", losing the leading colon.  Post-#568 it returns Err.
public fn test_parse_empty_scheme(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  match url_parse(":foo") {
    Ok(_) -> 0,
    Err(_) -> 1
  }
}

public fn test_join_full(@Unit -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  match url_parse("https://example.com/path?q=1#frag") {
    Ok(@UrlParts) -> url_join(@UrlParts.0),
    Err(@String) -> @String.0
  }
}

public fn test_roundtrip(@Unit -> @String)
  requires(true)
  ensures(true)
  effects(pure)
{
  match url_parse("https://example.com/path?q=1#frag") {
    Ok(@UrlParts) -> match url_parse(url_join(@UrlParts.0)) {
      Ok(@UrlParts) -> parts(@UrlParts.0),
      Err(@String) -> @String.0
    },
    Err(@String) -> @String.0
  }
}

-- The run: every part each parse produced, the joined URL, and the two
-- rejected inputs.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("full \(test_parse_full(()))\n");
  IO.print("no query \(test_parse_no_query(()))\n");
  IO.print("no scheme \(test_parse_err(()))\n");
  IO.print("empty scheme \(test_parse_empty_scheme(()))\n");
  IO.print("join \(test_join_full(()))\n");
  IO.print("roundtrip \(test_roundtrip(()))\n")
}
