-- Chapter 2, Section 2.4 "Algebraic Data Types"
-- Tests: E129 — a recursive occurrence of a type inside its own declaration
-- must instantiate it at that declaration's own type parameters, in order.
-- `Nest<Option<T>>` grows the argument at every level, so the chain
-- `Nest<Int>` -> `Nest<Option<Int>>` -> `Nest<Option<Option<Int>>>` never
-- repeats and the type has no finite set of instantiations.

private data Nest<T> {
  N(Nest<Option<T>>),
  Z
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  0
}
