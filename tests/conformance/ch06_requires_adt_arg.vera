-- Conformance: a callee whose requires() constrains ADT-typed parameters gets a
-- call-site precondition obligation, discharged statically at Tier-1 exactly
-- like Int parameters (Chapter 6, #882).
-- Tests: requires clause over ADT equality, call-site precondition discharge
private data Point {
  MkPoint(Int)
}

-- Both points' coordinates, summed, so the run reads what reached the callee.
private fn coordinate_sum(@Point, @Point -> @Int)
  requires(@Point.1 == @Point.0)
  ensures(true)
  effects(pure)
{
  match @Point.1 {
    MkPoint(@Int) -> match @Point.0 {
      MkPoint(@Int) -> @Int.1 + @Int.0
    }
  }
}

-- The run: the callee on two equal constructions, then on one binding passed
-- twice.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("constructions \(coordinate_sum(MkPoint(3), MkPoint(3)))\n");
  let @Point = MkPoint(0 - 20);
  IO.print("binding \(coordinate_sum(@Point.0, @Point.0))\n")
}
