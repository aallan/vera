-- Conformance: abilities and constrained generics (Chapter 9)
-- Tests: Eq, Ord, Hash, Show abilities; ADT auto-derivation; constrained generics
-- ================================================================
-- Helper: constrained generic Eq
-- ================================================================
private forall<T where Eq<T>> fn are_equal(@T, @T -> @Bool)
  requires(true)
  ensures(true)
  effects(pure)
{
  eq(@T.1, @T.0)
}

-- ================================================================
-- Eq ability
-- ================================================================
-- Test: are_equal with equal Ints returns 1
public fn test_eq_int_equal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  if are_equal(42, 42) then {
    1
  } else {
    0
  }
}

-- Test: are_equal with unequal Ints returns 0
public fn test_eq_int_unequal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 0)
  effects(pure)
{
  if are_equal(1, 2) then {
    1
  } else {
    0
  }
}

-- Test: are_equal with equal Bools returns 1
public fn test_eq_bool_equal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  if are_equal(true, true) then {
    1
  } else {
    0
  }
}

-- Test: are_equal with unequal Bools returns 0
public fn test_eq_bool_unequal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 0)
  effects(pure)
{
  if are_equal(true, false) then {
    1
  } else {
    0
  }
}

-- Test: eq used directly in a non-generic context
public fn test_eq_direct(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  eq(10, 10)
}

-- Test: eq used directly with unequal values
public fn test_eq_direct_unequal(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == false)
  effects(pure)
{
  eq(7, 8)
}

-- ADT for Eq auto-derivation tests
private data Color {
  Red,
  Green,
  Blue
}

-- Test: ADT auto-derivation for Eq (equal constructors)
public fn test_eq_adt_equal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  if are_equal(Red, Red) then {
    1
  } else {
    0
  }
}

-- Test: ADT auto-derivation for Eq (unequal constructors)
public fn test_eq_adt_unequal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 0)
  effects(pure)
{
  if are_equal(Red, Blue) then {
    1
  } else {
    0
  }
}

-- ================================================================
-- Ord ability (compare)
-- ================================================================
-- Test: compare less — 1 < 2 → Less
public fn test_compare_less(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  match compare(1, 2) {
    Less -> 1,
    Equal -> 2,
    Greater -> 3
  }
}

-- Test: compare equal — 5 == 5 → Equal
public fn test_compare_equal(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 2)
  effects(pure)
{
  match compare(5, 5) {
    Less -> 1,
    Equal -> 2,
    Greater -> 3
  }
}

-- Test: compare greater — 9 > 3 → Greater
public fn test_compare_greater(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 3)
  effects(pure)
{
  match compare(9, 3) {
    Less -> 1,
    Equal -> 2,
    Greater -> 3
  }
}

-- Helper: constrained generic Ord
private forall<T where Ord<T>> fn cmp_sign(@T, @T -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  match compare(@T.1, @T.0) {
    Less -> 0 - 1,
    Equal -> 0,
    Greater -> 1
  }
}

-- Test: compare in constrained generic
public fn test_compare_generic(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 0 - 1)
  effects(pure)
{
  cmp_sign(3, 7)
}

-- ================================================================
-- Show ability
-- ================================================================
-- Test: show(42) produces "42"
public fn test_show_int(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  eq(show(42), "42")
}

-- Test: show(true) produces "true"
public fn test_show_bool(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  eq(show(true), "true")
}

-- Test: show on String is identity
public fn test_show_string(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  eq(show("hello"), "hello")
}

-- ================================================================
-- Hash ability
-- ================================================================
-- Test: hash(42) is identity for Int
public fn test_hash_int(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 42)
  effects(pure)
{
  hash(42)
}

-- Test: hash(true) == 1
public fn test_hash_bool(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  hash(true)
}

-- Test: hash is consistent (same input → same output)
public fn test_hash_consistent(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  eq(hash("hello"), hash("hello"))
}

-- ================================================================
-- Eq / Ord ability operations in CONTRACT position (#874, spec §6.3.1)
-- ----------------------------------------------------------------
-- `eq(a, b)` and `compare(a, b)` are the generic-programming spelling of
-- `==` and the three-way `Ordering` comparison, and may appear directly in
-- a contract predicate.  Each is verified AND compiled as its canonical
-- operator form (Tier-1 proved, runtime-enforced), so these functions
-- exercise the ability op inside `ensures` / `requires` — the exact path
-- that pre-#874 tripped an uncaught CodegenSkip and a Tier-3 demotion.
-- ================================================================
-- Test: eq in ensures — the postcondition proves at Tier 1 and enforces.
public fn test_eq_in_ensures(@Unit -> @Int)
  requires(true)
  ensures(eq(@Int.result, 3))
  effects(pure)
{
  3
}

-- Test: eq in requires — the precondition proves at the call site below.
public fn requires_eq_three(@Int -> @Int)
  requires(eq(@Int.0, 3))
  ensures(@Int.result == @Int.0)
  effects(pure)
{
  @Int.0
}

public fn test_eq_in_requires(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 3)
  effects(pure)
{
  requires_eq_three(3)
}

-- Test: compare in ensures — the result equals the input, so their
-- three-way comparison is Equal (universally provable at Tier 1).
public fn test_compare_in_ensures(@Int -> @Int)
  requires(true)
  ensures(compare(@Int.result, @Int.0) == Equal)
  effects(pure)
{
  @Int.0
}

-- Test: compare in requires — a precondition that the input compares
-- Less than 5, discharged at the call site below (3 < 5).
public fn requires_compare_lt5(@Int -> @Int)
  requires(compare(@Int.0, 5) == Less)
  ensures(@Int.result == @Int.0)
  effects(pure)
{
  @Int.0
}

-- Test: driver so both compare-in-contract functions run at run level.
public fn test_compare_in_contract_driver(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 3)
  effects(pure)
{
  requires_compare_lt5(test_compare_in_ensures(3))
}

-- Test: an ability op in a WHERE-helper's OWN contract (#874, PR #887).
-- The helper's ensures uses eq; the same canonicalization must reach a
-- where-fn's contract clauses, not just top-level ones.
public fn test_eq_in_where_fn_contract(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 3)
  effects(pure)
{
  where_helper(3)
}
where {
  fn where_helper(@Int -> @Int)
    requires(true)
    ensures(eq(@Int.result, @Int.0))
    effects(pure)
  {
    @Int.0
  }
}

-- ================================================================
-- The run: every test above, equal beside unequal and each ordering
-- outcome, the abilities in contracts among them.
-- ================================================================
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("eq int \(test_eq_int_equal(())) \(test_eq_int_unequal(()))\n");
  IO.print("eq bool \(test_eq_bool_equal(())) \(test_eq_bool_unequal(()))\n");
  IO.print("eq direct \(test_eq_direct(())) \(test_eq_direct_unequal(()))\n");
  IO.print("eq data \(test_eq_adt_equal(())) \(test_eq_adt_unequal(()))\n");
  IO.print("compare \(test_compare_less(())) \(test_compare_equal(())) \(test_compare_greater(())), generic \(test_compare_generic(()))\n");
  IO.print("show \(test_show_int(())) \(test_show_bool(())) \(test_show_string(()))\n");
  IO.print("hash \(test_hash_int(())) \(test_hash_bool(())) \(test_hash_consistent(()))\n");
  IO.print("eq in contracts \(test_eq_in_ensures(())) \(test_eq_in_requires(())) \(test_eq_in_where_fn_contract(()))\n");
  IO.print("compare in contracts \(test_compare_in_ensures(4)) \(test_compare_in_contract_driver(()))\n")
}
