-- Conformance: generic instantiation inferred from a user-fn return in
--   argument position (Chapter 9)
-- Tests: a generic (option_unwrap_or, pick_first) whose type argument must be
--        recovered from a USER-fn call's return type used in an argument
--        position resolves to the precise concrete type, not the Bool
--        phantom-var default (#878).  Pre-fix the WASM call-rewrite consultor
--        collapsed a user fn's i32 handle return (Decimal) to Bool and emitted
--        a call to a clone Pass 1.5 never produced, skipping the caller on a
--        check-green program.
-- ================================================================
-- d — user helper returning @Decimal (an i32 handle), used as the
-- inference driver in argument position below.
-- ================================================================
private fn d(@String -> @Decimal)
  requires(true)
  ensures(true)
  effects(pure)
{
  option_unwrap_or(decimal_from_string(@String.0), decimal_from_int(0))
}

-- ================================================================
-- test_user_fn_fallback_arg
-- option_unwrap_or(decimal_div(...), d("0")) — the fallback @T is a
-- user-fn call returning @Decimal; the generic must instantiate at Decimal.
-- 1/3 divides cleanly, so the Some branch is taken and d("0") is the type
-- driver, not the value.  The check compares the quotient with its 28-digit
-- expansion, so a wrong nonzero value fails it as the fallback does.
-- ================================================================
public fn test_user_fn_fallback_arg(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  let @Decimal = option_unwrap_or(decimal_div(d("1"), d("3")), d("0"));
  if decimal_eq(@Decimal.0, d("0.3333333333333333333333333333")) then {
    1
  } else {
    0
  }
}

-- ================================================================
-- test_user_fn_fallback_taken
-- decimal_div(x, 0) is None, so the user-fn fallback value d("7") flows
-- through — confirms the Decimal clone is not just discovered but correct.
-- ================================================================
public fn test_user_fn_fallback_taken(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  let @Decimal = option_unwrap_or(decimal_div(d("1"), d("0")), d("7"));
  if decimal_eq(@Decimal.0, decimal_from_int(7)) then {
    1
  } else {
    0
  }
}

-- ================================================================
-- pick_first — a user generic whose type parameter is bound SOLELY by a
-- user-fn call in bare @T argument position (no constructor, no builtin
-- to mask the resolution).
-- ================================================================
private forall<T> fn pick_last(@T, @T -> @T)
  requires(true)
  ensures(true)
  effects(pure)
{
  @T.0
}

-- ================================================================
-- test_bare_typevar_user_fn
-- pick_last(d("5"), d("9")) instantiates T = Decimal from the user-fn
-- returns and returns the most-recent (De Bruijn @T.0) argument, d("9").
-- ================================================================
public fn test_bare_typevar_user_fn(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 1)
  effects(pure)
{
  let @Decimal = pick_last(d("5"), d("9"));
  if decimal_eq(@Decimal.0, decimal_from_int(9)) then {
    1
  } else {
    0
  }
}

-- The run: each test's verdict, then the quotient the first one compares.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("fallback arg \(test_user_fn_fallback_arg(()))\n");
  IO.print("fallback taken \(test_user_fn_fallback_taken(()))\n");
  IO.print("bare type variable \(test_bare_typevar_user_fn(()))\n");
  let @Decimal = option_unwrap_or(decimal_div(d("1"), d("3")), d("0"));
  IO.print("1 / 3 = \(decimal_to_string(@Decimal.0))\n")
}
