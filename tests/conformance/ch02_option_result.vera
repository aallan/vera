-- Conformance: Option and Result types (Chapter 2)
-- Tests: Option<T> matching; Result<T,E> matching (types from prelude)
private fn unwrap_or(@Option<Int>, @Int -> @Int)
  requires(true)
  ensures(match @Option<Int>.0 { Some(@Int) -> @Int.result == @Int.0, None -> @Int.result == @Int.0 })
  effects(pure)
{
  match @Option<Int>.0 {
    Some(@Int) -> @Int.0,
    None -> @Int.0
  }
}

private fn result_or(@Result<Int, String>, @Int -> @Int)
  requires(true)
  ensures(match @Result<Int, String>.0 { Ok(@Int) -> @Int.result == @Int.0, Err(@String) -> @Int.result == @Int.0 })
  effects(pure)
{
  match @Result<Int, String>.0 {
    Ok(@Int) -> @Int.0,
    Err(@String) -> @Int.0
  }
}

-- The run: both arms of each match, `Some` and `None`, `Ok` and `Err`.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("some \(unwrap_or(Some(42), 0))\n");
  IO.print("none \(test_none(()))\n");
  IO.print("ok \(test_ok(()))\n");
  IO.print("err \(test_err(()))\n")
}

public fn test_none(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 99)
  effects(pure)
{
  unwrap_or(None, 99)
}

public fn test_ok(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 7)
  effects(pure)
{
  result_or(Ok(7), 0)
}

public fn test_err(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == -1)
  effects(pure)
{
  result_or(Err("oops"), -1)
}
