public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("hello\nworld");
  IO.print("col1\tcol2");
  IO.print("back\\slash");
  IO.print("say \"hi\"");
  IO.print("A\n");
  let @String = "\r";
  let @String = "\0";
  let @String = "é";
  IO.print("carriage return \(string_char_code(@String.2, 0))\n");
  IO.print("nul \(string_char_code(@String.1, 0))\n");
  IO.print("two-byte escape \(@String.0) of \(string_length(@String.0)) bytes\n");
  IO.print("escaped newline length \(test_escape_length(()))\n")
}

public fn test_escape_length(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 3)
  effects(pure)
{
  string_length("a\nb")
}
