-- Conformance: State<T> effect handler over a COMPOSITE type argument (Chapter 7)
-- Tests: handle[State<Option<Int>>] and handle[State<Tuple<Int, Int>>] — the
-- composite type arg is escaped for the state_* WAT identifiers and the
-- handler-body get/put/push/pop calls match the (import ...) decls (#914).
public fn test_option_state(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Option<Int>>](@Option<Int> = Some(5)) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Int>) -> { resume(()) }
  } in {
    put(Some(9));
    option_unwrap_or(get(()), 0)
  }
}

public fn test_tuple_state(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  handle[State<Tuple<Int, Int>>](@Tuple<Int, Int> = Tuple(20, 22)) {
    put(@Tuple<Int, Int>) -> { resume(()) }
  } in {
    0
  }
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 9)
  effects(pure)
{
  test_option_state(())
}
