module ch08_xmod_widen_lib;

-- Conformance: cross-module @Nat -> @Int widening library (Chapter 8, spec §11.2.1)
-- Features: cross_module, nat_int_widening
--
-- An imported body that reads a @Nat as an @Int twice: bound into an @Int
-- slot, and stored as an element of an Array<Int>.  A @Nat is the
-- non-negative i64, so each read is the identity, with nothing to obligate
-- or check, in an imported body as in the importer's own.
public fn widen_elem(@Nat -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  let @Int = @Nat.0;
  let @Array<Int> = [@Int.0, @Nat.0];
  @Array<Int>.0[1]
}
