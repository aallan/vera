-- Conformance: comparison operators (Chapter 4)
-- Tests: ==, !=, <, >, <=, >=
public fn test_eq(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  5 == 5
}

public fn test_neq(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  5 != 3
}

public fn test_lt(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  3 < 5
}

public fn test_gt(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  5 > 3
}

public fn test_le(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  5 <= 5
}

public fn test_ge(@Unit -> @Bool)
  requires(true)
  ensures(@Bool.result == true)
  effects(pure)
{
  5 >= 5
}

-- The run: every operator above, each test's value and, beside it, the same
-- operator on operands it must refuse.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  IO.print("eq \(test_eq(())) \(5 == 3)\n");
  IO.print("neq \(test_neq(())) \(5 != 5)\n");
  IO.print("lt \(test_lt(())) \(5 < 3)\n");
  IO.print("gt \(test_gt(())) \(3 > 5)\n");
  IO.print("le \(test_le(())) \(6 <= 5)\n");
  IO.print("ge \(test_ge(())) \(4 >= 5)\n")
}
