-- Conformance: an imported module may not declare a data type named after
-- one of the prelude's (Chapter 8, Section 8.4.1).
-- Tests: E158 -- `vera.shadowlib` declares `private data Json`, and the
-- prelude's data types are reserved names in every file (#1469), so the
-- program is refused at check, at the module's declaration, although nothing
-- in it names `Json`.  The other importer of the module,
-- `ch08_module_prelude_adt_contention_rejected.vera`, also uses the prelude's
-- `Json` and is refused by the same declaration.
import vera.shadowlib(blob_size);

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 7)
  effects(pure)
{
  blob_size(7)
}
