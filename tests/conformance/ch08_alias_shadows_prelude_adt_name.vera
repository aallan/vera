-- Conformance: a type alias may not take a prelude data type's name
-- (Chapter 8, Section 8.4.1).
-- Tests: E158 -- the prelude's data types are reserved names (#1469), so
-- `type Option = Int;` and `type Result = String;` are refused at check, at
-- each alias.  An alias used to shadow the prelude's type, its target's width
-- being what a slot emitted (#1309); a second meaning of `Option` in one
-- program is now a check error instead.
type Option = Int;

type Result = String;

private fn twice(@Option -> @Int)
  requires(true)
  ensures(@Int.result == @Option.0 + @Option.0)
  effects(pure)
{
  @Option.0 + @Option.0
}

private fn doubled_length(@Result -> @Int)
  requires(true)
  ensures(@Int.result >= 0)
  effects(pure)
{
  string_length(string_concat(@Result.0, @Result.0))
}

public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result == 42)
  effects(pure)
{
  assert(doubled_length("ab") == 4);
  assert(twice(21) == 42);
  42
}
