-- Conformance: recursive ADTs (Chapter 2)
-- Tests: recursive data type, structural recursion with decreases
private data List<T> {
  Nil,
  Cons(T, List<T>)
}

private fn length(@List<Int> -> @Nat)
  requires(true)
  ensures(match @List<Int>.0 { Nil -> @Nat.result == 0, Cons(@Int, @List<Int>) -> @Nat.result >= 1 })
  decreases(@List<Int>.0)
  effects(pure)
{
  match @List<Int>.0 {
    Nil -> 0,
    Cons(@Int, @List<Int>) -> 1 + length(@List<Int>.0)
  }
}

private fn sum(@List<Int> -> @Int)
  requires(true)
  ensures(match @List<Int>.0 { Nil -> @Int.result == 0, Cons(@Int, @List<Int>) -> true })
  decreases(@List<Int>.0)
  effects(pure)
{
  match @List<Int>.0 {
    Nil -> 0,
    Cons(@Int, @List<Int>) -> @Int.0 + sum(@List<Int>.0)
  }
}

-- A recursion's value is no contract's to state (E138: a contract may not
-- call its own function), so the length is checked at run time.
public fn main(@Unit -> @Int)
  requires(true)
  ensures(@Int.result >= 1)
  effects(pure)
{
  let @Nat = length(Cons(1, Cons(2, Cons(3, Nil))));
  assert(@Nat.0 == 3);
  @Nat.0
}

public fn test_sum(@Unit -> @Int)
  requires(true)
  ensures(true)
  effects(pure)
{
  let @Int = sum(Cons(10, Cons(20, Cons(30, Nil))));
  assert(@Int.0 == 60);
  @Int.0
}
