-- Conformance: old(State<T>) / new(State<T>) over a COMPOSITE type argument
-- (Chapter 7).  Tests: an ensures postcondition referencing old(State<Option<Int>>)
-- and new(State<Option<Int>>) — the pre-execution snapshot local is allocated
-- under the canonical slot name and the composite == lowers at i32 (#914).
public fn keep(@Unit -> @Unit)
  requires(true)
  ensures(new(State<Option<Int>>) == old(State<Option<Int>>))
  effects(<State<Option<Int>>>)
{
  let @Option<Int> = get(());
  put(@Option<Int>.0);
  ()
}

-- The run: `keep` under a handler of its cell, whose postcondition compares
-- the cell before and after the call, then the cell read back.
public fn main(@Unit -> @Unit)
  requires(true)
  ensures(true)
  effects(<IO>)
{
  let @Option<Int> = handle[State<Option<Int>>](@Option<Int> = Some(5)) {
    get(@Unit) -> { resume(@Option<Int>.0) },
    put(@Option<Int>) -> { resume(()) }
  } in {
    keep(());
    get(())
  };
  IO.print("kept \(option_unwrap_or(@Option<Int>.0, 0))\n")
}
